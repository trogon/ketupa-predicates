<UserControl
    x:Class="Trogon.KetupaPredicates.Inspector.EvaluatorFeature.Evaluator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Trogon.KetupaPredicates.Inspector.EvaluatorFeature"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <Thickness x:Key="TextLabelMargin">5</Thickness>
                <Thickness x:Key="ActionButtonPadding">10,3</Thickness>
                <Thickness x:Key="InputTextPadding">3,5</Thickness>
                <DataTemplate x:Key="VariableItemTemplate">
                    <TextBlock>
                        <Run Text="{Binding Name, Mode=OneTime}" />
                        <Run>=</Run>
                        <Run Text="{Binding TextValue, Mode=OneTime}" />
                    </TextBlock>
                </DataTemplate>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="5*" />
            <RowDefinition Height="7*" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" DataContext="{Binding Configuration, Mode=OneTime}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Margin="{DynamicResource TextLabelMargin}" Text="Predicate text" />
            <TextBox
                Grid.Row="1"
                Grid.RowSpan="3"
                AcceptsReturn="True"
                AcceptsTab="True"
                FontFamily="Cascadia Mono,Consolas"
                Text="{Binding PredicateText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />
        </Grid>

        <GridSplitter
            Grid.Row="1"
            Grid.ColumnSpan="3"
            Height="3"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            ResizeDirection="Rows"
            ShowsPreview="true" />

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="103*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                Grid.Row="0"
                Margin="{DynamicResource TextLabelMargin}"
                Text="Variables" />
            <ListBox
                Grid.Row="1"
                Grid.RowSpan="3"
                DataContext="{Binding Configuration, Mode=OneTime}"
                ItemTemplate="{DynamicResource VariableItemTemplate}"
                ItemsSource="{Binding Variables, Mode=OneWay}"
                SelectedItem="{Binding SelectedVariable, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}" />
            <StackPanel Grid.Row="2" Orientation="Horizontal">
                <TextBlock
                    Margin="{DynamicResource TextLabelMargin}"
                    VerticalAlignment="Center"
                    Text="New variable name:" />
                <TextBox
                    MinWidth="200"
                    MinHeight="25"
                    Margin="{DynamicResource TextLabelMargin}"
                    Padding="{DynamicResource InputTextPadding}"
                    DataContext="{Binding Configuration, Mode=OneTime}"
                    Text="{Binding VariableName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock
                    Margin="{DynamicResource TextLabelMargin}"
                    VerticalAlignment="Center"
                    Text="with value:" />
                <TextBox
                    MinWidth="200"
                    Margin="{DynamicResource TextLabelMargin}"
                    Padding="{DynamicResource InputTextPadding}"
                    DataContext="{Binding Configuration, Mode=OneTime}"
                    Text="{Binding VariableTextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Margin="{DynamicResource TextLabelMargin}"
                    Padding="{DynamicResource ActionButtonPadding}"
                    Command="{Binding AddVariableCommand}"
                    Content="Add" />
                <Button
                    Margin="{DynamicResource TextLabelMargin}"
                    Padding="{DynamicResource ActionButtonPadding}"
                    Command="{Binding RemoveVariableCommand}"
                    Content="Remove" />
            </StackPanel>
        </Grid>

        <GridSplitter
            Grid.Row="2"
            Grid.ColumnSpan="3"
            Height="3"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            ResizeDirection="Rows"
            ShowsPreview="true" />

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="103*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock
                    Margin="{DynamicResource TextLabelMargin}"
                    VerticalAlignment="Center"
                    Text="Result" />
                <Button
                    Margin="{DynamicResource TextLabelMargin}"
                    Padding="{DynamicResource ActionButtonPadding}"
                    Command="{Binding EvaluateCommand}"
                    Content="Evaluate" />
            </StackPanel>
            <TextBox
                Grid.Row="1"
                DataContext="{Binding Configuration, Mode=OneTime}"
                IsReadOnly="True"
                Text="{Binding EvaluationResult, Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
