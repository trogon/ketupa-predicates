<Window
    x:Class="Trogon.KetupaPredicates.Inspector.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fa="clr-namespace:Trogon.KetupaPredicates.Inspector.AnalysisFeature"
    xmlns:fd="clr-namespace:Trogon.KetupaPredicates.Inspector.DesignerFeature"
    xmlns:fe="clr-namespace:Trogon.KetupaPredicates.Inspector.EvaluatorFeature"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Ketupa Predicates Inspector"
    Width="950"
    Height="650"
    mc:Ignorable="d">
    <Grid>
        <TabControl>
            <TabItem
                Padding="10,5"
                FontSize="14"
                Visibility="Collapsed">
                <TabItem.Header>
                    <TextBlock>
                        <Run BaselineAlignment="Center" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets">&#xE7BE;</Run>
                        <Run>Analysis</Run>
                    </TextBlock>
                </TabItem.Header>
                <fa:Analyst />
            </TabItem>
            <TabItem
                Padding="10,5"
                FontSize="14"
                IsSelected="True">
                <TabItem.Header>
                    <TextBlock>
                        <Run BaselineAlignment="Center" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets">&#xE74C;</Run>
                        <Run>Design</Run>
                    </TextBlock>
                </TabItem.Header>
                <fd:Designer />
            </TabItem>
            <TabItem Padding="10,5" FontSize="14">
                <TabItem.Header>
                    <TextBlock>
                        <Run BaselineAlignment="Center" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets">&#xE768;</Run>
                        <Run>Evaluation</Run>
                    </TextBlock>
                </TabItem.Header>
                <fe:Evaluator />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
