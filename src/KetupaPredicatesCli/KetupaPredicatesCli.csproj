<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Predicate analytics tool</Description>
    <GenerateDocumentationFile>False</GenerateDocumentationFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RootNamespace>Trogon.KetupaPredicates.Cli</RootNamespace>
    <!-- Base target frameworks - net10.0 can be enabled when .NET 10 becomes available -->
    <TargetFrameworks Condition="'$(IncludeNet10)' != 'true'">net8.0;net6.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(IncludeNet10)' == 'true'">net10.0;net8.0;net6.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KetupaPredicates\KetupaPredicates.csproj" />
  </ItemGroup>

</Project>
